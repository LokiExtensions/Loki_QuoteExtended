{
    "name": "loki-checkout/magento2-quote-extended",
    "version": "0.0.2",
    "description": "Store additional quote data in a separate table and link it to the order",
    "keywords": [
        "loki-checkout",
        "loki-checkout-category-other"
    ],
    "type": "magento2-module",
    "require": {
        "loki-checkout/magento2-core": "^2.3",
        "loki/magento2-components": "^2.2",
        "loki/magento2-field-components": "^2.2",
        "magento/framework": "^103.0",
        "magento/module-cron": "^100.4",
        "magento/module-quote": "^101.2",
        "magento/module-sales": "^103.0",
        "magento/module-store": "^101.1",
        "php": ">=8.2 <8.6",
        "psr/log": "^1.0 | ^2.0 | ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "yireo/magento2-integration-test-helper": "~0.0",
        "loki/magento2-functional-tests": "@dev"
    },
    "license": "OSL-3.0",
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Loki\\QuoteExtended\\": ""
        }
    }
