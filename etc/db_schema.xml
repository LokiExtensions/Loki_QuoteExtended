<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="loki_quote_extended" resource="checkout" engine="innodb" comment="Loki Quote Extended">
        <column name="id" xsi:type="int" identity="true" unsigned="true" nullable="false" comment="ID"/>
        <column name="quote_id" xsi:type="int" unsigned="true" nullable="false" comment="Quote ID"/>
        <column name="created_at" xsi:type="timestamp" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column name="updated_at" xsi:type="timestamp" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="LOKI_QUOTE_EXTENDED_QUOTE_ID">
            <column name="quote_id"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="LOKI_QUOTE_EXTENDED_QUOTE_ID_QUOTE_ENTITY_ID"
                    table="loki_quote_extended"
                    column="quote_id"
                    referenceTable="quote"
                    referenceColumn="entity_id"
                    onDelete="CASCADE"/>
    </table>
</schema>
